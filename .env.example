# =============================================================================
# Turnos — plantilla de variables de entorno
# Copiar a .env.local y completar. .env.local NUNCA se sube al repo.
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 0. General
# -----------------------------------------------------------------------------
# URL publica de la app. En local: http://localhost:3000
# En produccion o con tunel ngrok, poner la URL publica real.
# La usan Mercado Pago y n8n para volver a llamar al sistema.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant por defecto que se muestra si la URL no indica otro.
NEXT_PUBLIC_DEFAULT_TENANT=demo

# -----------------------------------------------------------------------------
# 1. Proveedor de datos — decide toda la capa de persistencia
#    Valores validos: "airtable" | "firebase" | "mock"
#    "mock" = datos de ejemplo en memoria, no requiere ninguna cuenta.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATA_PROVIDER=airtable

# --- Opcion A: Airtable ------------------------------------------------------
# Token de API con permisos de lectura/escritura: https://airtable.com/create/tokens
AIRTABLE_API_KEY=
# ID del Base (empieza con "app..."), visible en la URL del Base.
AIRTABLE_BASE_ID=
# Nombres de las tablas (cambiar solo si se nombraron distinto en Airtable).
AIRTABLE_TABLE_TENANTS=Tenants
AIRTABLE_TABLE_SERVICES=Services
AIRTABLE_TABLE_PROFESSIONALS=Professionals
AIRTABLE_TABLE_CLIENTS=Clients
AIRTABLE_TABLE_BOOKINGS=Bookings

# --- Opcion B: Firebase (cliente) --------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Opcion B: Firebase Admin (escrituras privilegiadas desde el servidor) ----
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private key va entre comillas y con los \n literales.
FIREBASE_ADMIN_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# 2. Mercado Pago — cobro de senia o total
#    Credenciales de PRUEBA (sandbox): mercadopago.com.ar/developers
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Clave secreta de la firma del webhook (Mercado Pago > Webhooks > Configurar).
MERCADOPAGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 3. n8n — automatizaciones (WhatsApp, email, recordatorios)
#    Estas 4 URLs las genera n8n al crear cada nodo Webhook.
#    Si quedan vacias, el sistema loguea el evento y sigue sin romper nada.
# -----------------------------------------------------------------------------
N8N_WEBHOOK_BOOKING_CREATED=
N8N_WEBHOOK_BOOKING_CANCELLED=
N8N_WEBHOOK_BOOKING_RESCHEDULED=
N8N_WEBHOOK_REMINDER_24H=
N8N_WEBHOOK_PAYMENT_CONFIRMED=

# Secreto compartido: se firma cada payload saliente con HMAC-SHA256 y se envia
# en el header X-Turnos-Signature. n8n debe validarlo con el mismo secreto.
# Tambien valida las llamadas ENTRANTES de n8n hacia /api/n8n/*.
N8N_WEBHOOK_SECRET=

# Habilita/deshabilita el envio real de eventos a n8n sin borrar las URLs.
N8N_ENABLED=true
