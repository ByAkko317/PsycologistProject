# =============================================================================
# Turnos — plantilla de variables de entorno
#
#   cp .env.example .env.local
#
# .env.local NUNCA se sube al repo (ya está en .gitignore).
# Las credenciales de GitHub NO van acá: ver la sección 5 al final.
# =============================================================================

# -----------------------------------------------------------------------------
# 0. General
# -----------------------------------------------------------------------------
# URL publica de la app. En local: http://localhost:3000
# En produccion o con tunel ngrok, poner la URL publica real.
# La usan Mercado Pago y n8n para volver a llamar al sistema.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant por defecto que se muestra si la URL no indica otro.
NEXT_PUBLIC_DEFAULT_TENANT=demo


# =============================================================================
# 1. BASE DE DATOS
# =============================================================================
# Decide toda la capa de persistencia.
# Valores validos: "airtable" | "firebase" | "mock"
#   mock  = datos de ejemplo en memoria, no requiere ninguna cuenta
# Si se pide airtable/firebase pero faltan credenciales, degrada a mock solo.
NEXT_PUBLIC_DATA_PROVIDER=airtable

# --- Opcion A: Airtable (la que usa el proyecto hoy) -------------------------
#
# Como obtener las credenciales:
#   1. Crear una cuenta gratis en https://airtable.com
#   2. Crear un Base con 5 tablas: Tenants, Services, Professionals, Clients,
#      Bookings. Las columnas exactas estan en docs/airtable-schema.md
#   3. Token: https://airtable.com/create/tokens -> "Create new token"
#        scopes:  data.records:read  +  data.records:write  +  schema.bases:read
#        access:  solo el Base de este proyecto (no "all workspaces")
#        El token se muestra UNA sola vez: empieza con "pat..."
#   4. Base ID: esta en la URL del Base, empieza con "app..."
#        https://airtable.com/appXXXXXXXXXXXXXX/tblYYYY...
#                             ^^^^^^^^^^^^^^^^^^
#   5. Cargar datos de ejemplo:  pnpm seed:airtable
#
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Nombres de las tablas. Cambiar solo si se nombraron distinto en Airtable.
AIRTABLE_TABLE_TENANTS=Tenants
AIRTABLE_TABLE_SERVICES=Services
AIRTABLE_TABLE_PROFESSIONALS=Professionals
AIRTABLE_TABLE_CLIENTS=Clients
AIRTABLE_TABLE_BOOKINGS=Bookings

# --- Opcion B: Firebase (pendiente de implementar) ---------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Escrituras privilegiadas desde el servidor (Admin SDK).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private key va entre comillas y con los \n literales.
FIREBASE_ADMIN_PRIVATE_KEY=""


# =============================================================================
# 2. MERCADO PAGO — cobro de senia o total
# =============================================================================
#
# Como obtener las credenciales DE PRUEBA (no mueven plata real):
#   1. https://www.mercadopago.com.ar/developers/panel
#   2. "Tus integraciones" -> "Crear aplicacion"
#        Producto: Checkout Pro        Modelo: Pagos online
#   3. Dentro de la app -> "Credenciales de prueba"
#        Access Token  -> empieza con "TEST-"
#        Public Key    -> empieza con "TEST-"
#   4. Usuarios de prueba: "Cuentas de prueba" -> crear DOS
#        uno VENDEDOR (de ahi salen las credenciales) y uno COMPRADOR
#        (con ese se paga en el checkout)
#   5. Webhook: "Webhooks" -> "Configurar notificaciones"
#        URL:      https://TU-URL-PUBLICA/api/mercadopago/webhook
#        Evento:   Pagos
#        Copiar la "Clave secreta" que genera -> MERCADOPAGO_WEBHOOK_SECRET
#
# IMPORTANTE: si el Access Token empieza con "APP_USR-" son credenciales de
# PRODUCCION y los pagos son reales. Para probar, siempre "TEST-".
#
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Clave secreta de la firma del webhook. Si queda vacia, la app acepta cualquier
# notificacion y lo avisa por consola. En produccion es obligatoria.
MERCADOPAGO_WEBHOOK_SECRET=

# Base de la API de Mercado Pago. Solo se cambia para pruebas locales:
# apuntandola al simulador se prueba el flujo de pago completo sin cuenta.
#   pnpm mock:mercadopago     ->  MERCADOPAGO_API_BASE=http://localhost:4010
# Vacio = API real (https://api.mercadopago.com).
MERCADOPAGO_API_BASE=


# =============================================================================
# 3. n8n — automatizaciones (WhatsApp, email, recordatorios)
# =============================================================================
# Estas 5 URLs las genera n8n al crear cada nodo Webhook.
# Si quedan vacias, el sistema loguea el evento y sigue sin romper nada.
# Guia completa para el colaborador: n8n/README.md
N8N_WEBHOOK_BOOKING_CREATED=
N8N_WEBHOOK_BOOKING_CANCELLED=
N8N_WEBHOOK_BOOKING_RESCHEDULED=
N8N_WEBHOOK_REMINDER_24H=
N8N_WEBHOOK_PAYMENT_CONFIRMED=

# Secreto compartido con n8n. Cumple dos funciones:
#   - salida: firma cada payload con HMAC-SHA256 en X-Turnos-Signature
#   - entrada: valida el Bearer de las llamadas de n8n a /api/n8n/*
# Generarlo una sola vez y usar el mismo string de los dos lados:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=

# Corta el envio real a n8n sin tener que borrar las URLs.
N8N_ENABLED=true


# =============================================================================
# 4. CRON del recordatorio de 24hs
# =============================================================================
# Protege /api/cron/reminders. Si queda vacio se usa N8N_WEBHOOK_SECRET.
# Vercel Cron ya lo llama cada hora (ver vercel.json).
CRON_SECRET=


# =============================================================================
# 5. GITHUB — deliberadamente NO va acá
# =============================================================================
# Un token de GitHub no es una credencial de la aplicacion: la app nunca habla
# con GitHub. Ponerlo en .env.local significaria cargarlo en el proceso de
# Next.js y, si algun dia se sube a Vercel, quedaria en el entorno del deploy
# sin ninguna razon. Un token robado desde ahi da acceso de escritura al repo.
#
# Las credenciales de git van en .env.git (tambien ignorado por git):
#
#   cp .env.git.example .env.git      # completar
#   node scripts/setup-git-remote.mjs # conecta el remoto y deja todo listo
#
# Mas detalle, incluido que permisos pedirle al token:  docs/github.md
