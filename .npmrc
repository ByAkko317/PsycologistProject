# Configuracion de pnpm para este proyecto.

# Nota: el bloqueo de scripts de instalacion de las dependencias NO se hace aca
# sino con "pnpm.onlyBuiltDependencies" en package.json. La opcion
# ignore-scripts de .npmrc tambien apagaria los scripts del propio proyecto,
# incluido el guard preinstall que bloquea npm.

# Fallar si la version de Node/pnpm no coincide con "engines", en vez de
# instalar igual y romper mas adelante.
engine-strict=true

# Usar el lockfile tal cual esta. Si package.json y el lock no coinciden, falla
# en vez de resolver versiones nuevas por su cuenta.
prefer-frozen-lockfile=true

# node_modules aislado (default de pnpm): una dependencia solo puede importar
# lo que declara explicitamente.
node-linker=isolated

# Verificar el hash de cada paquete contra el store antes de usarlo.
verify-store-integrity=true

# Peers faltantes se instalan solos, pero un conflicto real avisa.
auto-install-peers=true
strict-peer-dependencies=false
