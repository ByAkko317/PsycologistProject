# =============================================================================
# Credenciales de git — NO son credenciales de la aplicacion.
#
#   cp .env.git.example .env.git
#
# .env.git esta en .gitignore. Este archivo lo lee unicamente
# scripts/setup-git-remote.mjs, que corre a mano desde la terminal; el proceso
# de Next.js nunca lo toca y nada de esto llega al deploy.
#
# Como sacar cada dato:  docs/github.md
# =============================================================================

# URL del repositorio, en formato HTTPS (sin el token adentro).
#   https://github.com/USUARIO/turnos-saas.git
GITHUB_REPO_URL=

# Tu usuario de GitHub.
GITHUB_USERNAME=

# Fine-grained Personal Access Token.
#   https://github.com/settings/personal-access-tokens/new
#   Repository access : Only select repositories -> este repo
#   Permissions       : Contents = Read and write   (con eso alcanza para push)
#   Expiration        : 90 dias
# Empieza con "github_pat_". Se muestra una sola vez.
GITHUB_TOKEN=

# Identidad de los commits. Si los dejas vacios se usa la config global de git.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
