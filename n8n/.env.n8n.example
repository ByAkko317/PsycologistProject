# =============================================================================
# Variables que van DENTRO de n8n — no las lee la app
# =============================================================================
#
#   cp n8n/.env.n8n.example n8n/.env.n8n      # .env.n8n esta en .gitignore
#
# Estan separadas del .env.example de la aplicacion a proposito. La app nunca
# habla con WhatsApp ni con Gmail: solo avisa "paso esto" y n8n decide a quien
# le escribe. Si estos valores vivieran en .env.local, alguien los cargaria ahi
# y nada funcionaria, sin ningun error que lo explique.
#
# Como se cargan, segun donde corras n8n:
#
#   Docker      docker run --env-file n8n/.env.n8n -p 5678:5678 n8nio/n8n
#   n8n Cloud   Settings -> Variables (una por una, desde la interfaz)
#
# Dentro de un workflow se leen con  {{ $env.NOMBRE_DE_LA_VARIABLE }}.


# -----------------------------------------------------------------------------
# Enlace con la aplicacion
# -----------------------------------------------------------------------------

# El MISMO string que N8N_WEBHOOK_SECRET en el .env.local de la app.
# Cumple dos funciones: valida la firma de los eventos que llegan, y autentica
# a n8n cuando le pide turnos a la app.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURNOS_WEBHOOK_SECRET=

# URL publica de la app: el dominio de Vercel, o la URL del tunel en local.
# Sin barra final.
TURNOS_APP_URL=

# Que negocio consulta el workflow de recordatorios.
TURNOS_TENANT_SLUG=demo


# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------
#
# El numero DESDE el que salen los mensajes.
#
#   Meta for Developers -> tu app -> WhatsApp -> Configuracion de la API
#   El campo dice "Identificador del numero de telefono". Es una cadena de
#   digitos; NO es el numero de telefono en si.
#
# Va aca y no dentro del JSON del workflow. Los workflows se versionan en un
# repositorio abierto: si el identificador queda escrito en el archivo,
# cualquiera que lo importe manda mensajes desde ESTE numero.
WHATSAPP_PHONE_NUMBER_ID=

# El token de WhatsApp NO va aca ni en ningun archivo.
# Se carga una sola vez en n8n: Credentials -> New -> WhatsApp API.
# n8n lo guarda cifrado y nunca lo incluye al exportar un workflow.
