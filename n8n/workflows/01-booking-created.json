      "notes": "URL a copiar en .env.local del proyecto Next.js"
    },
    {
      "parameters": {
        "jsCode": "// Valida la firma HMAC-SHA256 que manda la app en X-Turnos-Signature.\n// El secreto debe coincidir con N8N_WEBHOOK_SECRET del proyecto Next.js.\n// Guardalo en n8n como variable de entorno TURNOS_WEBHOOK_SECRET.\nconst crypto = require('crypto');\n\nconst secreto = $env.TURNOS_WEBHOOK_SECRET || '';\nconst entrada = $input.first();\nconst firmaRecibida = entrada.json.headers['x-turnos-signature'] || '';\nconst cuerpo = entrada.json.body;\n\nif (!secreto) {\n  throw new Error('Falta la variable de entorno TURNOS_WEBHOOK_SECRET en n8n');\n}\n\n// Importante: hay que firmar el JSON EXACTO que mando la app.\n// Por eso el nodo Webhook tiene rawBody activado.\nconst crudo = entrada.binary?.data\n  ? Buffer.from(entrada.binary.data.data, 'base64').toString('utf8')\n  : JSON.stringify(cuerpo);\n\nconst esperada = crypto.createHmac('sha256', secreto).update(crudo).digest('hex');\n\nconst iguales =\n  firmaRecibida.length === esperada.length &&\n  crypto.timingSafeEqual(Buffer.from(firmaRecibida), Buffer.from(esperada));\n\nif (!iguales) {\n  throw new Error('Firma invalida: la peticion no viene de la app de Turnos');\n}\n\nreturn [{ json: cuerpo }];"
      },
      "id": "1bb80d27-2385-40ae-94c1-da4d5e3839ac",
      "name": "Validar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        240
      ],
      "notes": "No borrar: sin esto cualquiera puede disparar mensajes a tus clientes"
    },
    {
      "parameters": {
        "jsCode": "// Arma el texto de confirmacion. Editalo libremente.\nconst d = $json.data;\nconst pagoPendiente = d.payment?.required && d.booking.paymentStatus !== 'paid';\n\nconst texto =\n  'Hola ' + d.client.name + '! Tu turno en ' + d.business.name + ' quedo reservado.\\n\\n' +\n  '\ud83d\udcc5 ' + d.display.date + ' a las ' + d.display.time + '\\n' +\n  '\ud83d\udcac ' + d.service.name + ' con ' + d.professional.name + '\\n' +\n  (pagoPendiente\n    ? '\\n\u26a0\ufe0f Falta abonar la sena de $' + d.payment.depositAmount + ':\\n' + d.payment.checkoutUrl + '\\n'\n    : '') +\n  '\\nSi necesitas cancelar o reprogramar (hasta ' + d.business.cancellationHours + 'hs antes):\\n' +\n  d.links.manage;\n\nreturn [{\n  json: {\n    para_whatsapp: d.client.phone,\n    para_email: d.client.email,\n    asunto: 'Turno confirmado en ' + d.business.name,\n    texto,\n    // Datos crudos por si el nodo de envio los necesita\n    original: $json,\n  },\n}];"
      },
